{
    "name": "alexskrypnyk/csvtable",
    "description": "PHP class to parse and format CSV content.",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Alex Skrypnyk",
            "email": "alex@drevops.com",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/AlexSkrypnyk/CsvTable",
    "support": {
        "issues": "https://github.com/AlexSkrypnyk/CsvTable/issues",
        "source": "https://github.com/AlexSkrypnyk/CsvTable"
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "drevops/phpcs-standard": "^0.7",
        "drupal/coder": "^9.0.1",
        "ergebnis/composer-normalize": "^2.53.0",
        "phpstan/phpstan": "^2.2.13",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.6.6"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "AlexSkrypnyk\\CsvTable\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexSkrypnyk\\CsvTable\\Tests\\": "tests/phpunit"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        },
        "discard-changes": true,
        "policy": {
            "advisories": {
                "block": false,
                "audit": "fail"
            },
            "abandoned": {
                "audit": "report"
            }
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "phpcs",
            "phpstan",
            "rector --dry-run"
        ],
        "lint-fix": [
            "rector",
            "phpcbf"
        ],
        "reset": "rm -Rf vendor composer.lock",
        "test": "phpunit --no-coverage",
        "test-coverage": "phpunit"
    }
}
